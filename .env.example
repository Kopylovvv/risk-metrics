POSTGRES_DB=risk_metrics
POSTGRES_USER=risk_metrics
POSTGRES_PASSWORD=replace_with_local_password

# Порты на компьютере разработчика; внутри Compose база всегда db:5432.
POSTGRES_PUBLISHED_PORT=5433
BACKEND_PORT=8000

# Для локального HTTP; на сервере с HTTPS понадобится COOKIE_SECURE=true.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
COOKIE_SECURE=false

# Доступ к web-сервису Cbonds. Пусто: источник не подключён, расчёт берёт данные только из БД.
# Публичный демо-доступ указан на https://cbonds.ru/api/catalog/
CBONDS_LOGIN=
CBONDS_PASSWORD=
